# =============================================================================
# Mrliou Particle System - Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# --- General ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Particle Runtime (L1 Gate) ---
PARTICLE_RUNTIME_PORT=3000
SEED_CORPUS_PATH=/data/seed-corpus

# --- EchoPersona Translation Module ---
ECHO_PERSONA_PORT=3001
TRANSLATION_MODE=bidirectional
PERSONA_SYNC_ENABLED=true

# --- MCP Gateway ---
MCP_GATEWAY_PORT=3002
MCP_TRANSPORT=streamable-http
MCP_AUTH_ENABLED=true

# --- Particle Chat v42 ---
PARTICLE_CHAT_PORT=3003
CHAT_VERSION=v42

# --- ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=mrliou_particles
CLICKHOUSE_USER=mrliou
CLICKHOUSE_PASSWORD=changeme

# --- GPG Signing ---
GPG_KEYRING_PATH=~/.gnupg
GPG_KEY_ID=

# --- AWS ECR Deployment ---
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=
AWS_ROLE_ARN=
ECR_REPOSITORY=mrliou-particle

# --- Persona Bundles ---
SEED_PERSONA_ENABLED=true
ECHO_PERSONA_ENABLED=true
FUTURE_PERSONA_ENABLED=true
DREAM_PERSONA_ENABLED=true
